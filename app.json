{
  "expo": {
    "name": "AshaMitra",
    "slug": "ashamitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ashamitra",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
